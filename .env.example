# ==========================================
# GSEM / GEMS Environment Configuration
# ==========================================

# Backend API URL (Default: http://localhost:5000/api/v1)
VITE_API_URL=http://localhost:5000/api/v1

# CARTO Basemaps API Key (Optional)
# CARTO now requires an API key to display custom Positron and Dark Matter tiles without an "API KEY REQUIRED" watermark.
# You can generate a free API key at: https://carto.com/basemaps/apikey/
# If left unset, GSEM automatically falls back to OpenStreetMap standard tiles (100% free, zero watermark, no key required).
VITE_CARTO_API_KEY=
